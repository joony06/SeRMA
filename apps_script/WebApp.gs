// ============================================================
//  WebApp.gs - 수동 실행 버튼 화면 (기존 화면 그대로)
// ============================================================

function doGet(e) {
  var html = '<!DOCTYPE html><html>'
    + '<head><meta name="viewport" content="width=device-width,initial-scale=1">'
    + '<meta http-equiv="Cache-Control" content="no-cache,no-store,must-revalidate">'
    + '<meta http-equiv="Pragma" content="no-cache">'
    + '<meta http-equiv="Expires" content="0">'
    + '<style>'
    + '*{box-sizing:border-box;margin:0;padding:0;}'
    + 'body{display:flex;flex-direction:column;justify-content:center;align-items:center;'
    + '     min-height:100vh;background:#f0f4f8;font-family:sans-serif;padding:32px 24px;}'
    + 'h2{font-size:26px;font-weight:700;color:#2c3e50;margin-bottom:28px;text-align:center;}'
    + 'button{width:100%;max-width:400px;padding:28px;font-size:24px;border-radius:20px;'
    + '       border:none;background:#4a90d9;color:white;cursor:pointer;'
    + '       box-shadow:0 4px 16px rgba(0,0,0,0.2);margin-bottom:32px;}'
    + 'button:disabled{background:#aaa;cursor:default;}'
    + '#steps{width:100%;max-width:400px;display:none;flex-direction:column;gap:12px;}'
    + '.step{padding:16px 20px;background:white;border-radius:14px;font-size:17px;'
    + '      color:#aaa;box-shadow:0 2px 8px rgba(0,0,0,0.07);transition:all 0.3s;}'
    + '.step.active{color:#4a90d9;font-weight:600;border-left:4px solid #4a90d9;}'
    + '.step.done{color:#27ae60;font-weight:600;border-left:4px solid #27ae60;}'
    + '.step.error{color:#e74c3c;font-weight:600;border-left:4px solid #e74c3c;}'
    + '#result{margin-top:20px;font-size:18px;color:#333;text-align:center;}'
    + '</style></head>'
    + '<body>'
    + '<h2>Seminar Reservation Management Automation</h2>'
    + '<button id="btn" onclick="runAll()">▶ Start</button>'
    + '<div id="steps">'
    + '  <div class="step" id="s1">🔐 Firebase Login</div>'
    + '  <div class="step" id="s2">📋 Fetching Data</div>'
    + '  <div class="step" id="s3">📝 Writing to Sheet</div>'
    + '</div>'
    + '<div id="result"></div>'
    + '<script>'
    + 'var labels={"s1":"🔐 Firebase Login","s2":"📋 Fetching Data","s3":"📝 Writing to Sheet"};'
    + 'function setStep(id,state){'
    + '  var el=document.getElementById(id);'
    + '  el.className="step "+state;'
    + '  if(state==="active") el.innerText=labels[id]+" (Processing...)";'
    + '  else if(state==="done") el.innerText=labels[id]+" (Complete)";'
    + '  else if(state==="error") el.innerText=labels[id]+" (Failed)";'
    + '  else el.innerText=labels[id];'
    + '}'
    + 'function runAll(){'
    + '  document.getElementById("btn").disabled=true;'
    + '  document.getElementById("steps").style.display="flex";'
    + '  document.getElementById("result").innerText="";'
    + '  setStep("s1","active");setStep("s2","");setStep("s3","");'
    + '  google.script.run'
    + '    .withSuccessHandler(function(){'
    + '      setStep("s1","done");setStep("s2","active");'
    + '      google.script.run'
    + '        .withSuccessHandler(function(count){'
    + '          setStep("s2","done");'
    + '          if(count===0){'
    + '            setStep("s3","done");'
    + '            document.getElementById("result").innerText="✅ No unchecked reservations.";'
    + '            document.getElementById("btn").disabled=false;return;'
    + '          }'
    + '          setStep("s3","active");'
    + '          google.script.run'
    + '            .withSuccessHandler(function(written){'
    + '              setStep("s3","done");'
    + '              document.getElementById("result").innerText="✅ Done! "+written+" record(s) added.";'
    + '              document.getElementById("btn").disabled=false;'
    + '            })'
    + '            .withFailureHandler(function(e){'
    + '              setStep("s3","error");'
    + '              document.getElementById("result").innerText="❌ Error: "+e.message;'
    + '              document.getElementById("btn").disabled=false;})'
    + '            .step3_write();'
    + '        })'
    + '        .withFailureHandler(function(e){'
    + '          setStep("s2","error");'
    + '          document.getElementById("result").innerText="❌ Error: "+e.message;'
    + '          document.getElementById("btn").disabled=false;})'
    + '        .step2_fetch();'
    + '    })'
    + '    .withFailureHandler(function(e){'
    + '      setStep("s1","error");'
    + '      document.getElementById("result").innerText="❌ Error: "+e.message;'
    + '      document.getElementById("btn").disabled=false;})'
    + '    .step1_login();'
    + '}'
    + '</script>'
    + '</body></html>';
  return HtmlService.createHtmlOutput(html)
    .setTitle('GBA Seminar Reservation Management Automation')
    .addMetaTag('viewport','width=device-width,initial-scale=1');
}
